# Copy only the settings you use into your own private file, or set process variables.
# Settings.from_env(env_file=...) reads only the explicitly selected file.
WRDS_USERNAME=
WRDS_PASSWORD=
DATABENTO_API_KEY=

# Optional LSEG settings; a desktop session needs a running, logged-in Workspace.
# LSEG_SESSION_NAME=desktop.workspace
# LSEG_APP_KEY=
# LSEG_CONFIG_FILE=/absolute/path/to/lseg-data.config.json

# Optional WRDS settings.
# WRDS_CONNECT_TIMEOUT=45
# WRDS_STATEMENT_TIMEOUT_MS=120000
# WRDS_PASSFILE=/absolute/path/to/.pgpass

# Optional process variable for data stored outside the checkout.
# hedging.paths reads this from the process environment, not from this file.
# HEDGE_DATA_DIR=/absolute/path/to/research-data
